default:
    @just --list

# Deliberate dependency installation. Review and commit uv.lock and pnpm-lock.yaml.
bootstrap:
    uv sync
    pnpm install

template-test:
    uv run --no-sync pytest tests

upgrade-test:
    REQUIRE_COPIER=1 uv run --no-sync pytest tests/test_real_copier.py

check:
    python3 tools/verify_workflows.py
    uv run --no-sync pytest tests
    pnpm run docs:check

generated-check preset="sidebar" docs="starlight":
    uv run --no-sync python tools/integration_matrix.py --preset "{{preset}}" --docs "{{docs}}"

docs-dev:
    pnpm run docs:dev

docs-build:
    pnpm run docs:build

bundle:
    python3 tools/bundle.py --output dist/iina-plugin-starter.zip


workflow-lint:
    python3 tools/workflow_lint.py
