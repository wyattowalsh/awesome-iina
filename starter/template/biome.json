{
  "$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
  "formatter": {
    "enabled": false
  },
  "assist": {
    "enabled": false
  },
  "files": {
    "includes": [
      "src/**/*.ts",
      "scripts/**/*.mjs",
      "tests/**/*.mjs"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": false,
      "correctness": {
        "noUnreachable": "error",
        "noConstantCondition": "error"
      },
      "suspicious": {
        "noDebugger": "error",
        "noDoubleEquals": "error",
        "noDuplicateParameters": "error",
        "noDuplicateCase": "error",
        "noDuplicateObjectKeys": "error",
        "noSelfCompare": "error"
      }
    }
  }
}
